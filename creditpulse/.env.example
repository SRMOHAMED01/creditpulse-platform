# ---- PostgreSQL ----
POSTGRES_USER=creditpulse
POSTGRES_PASSWORD=creditpulse_dev_password
POSTGRES_DB=creditpulse_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Backend / JWT ----
# Development only. Generate a different random value for every real deployment.
SECRET_KEY=dev-only-creditpulse-secret-key-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
MODEL_PATH=ml/model_registry/model.json
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REQUESTS=credit-requests
KAFKA_TOPIC_DECISIONS=credit-decisions

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

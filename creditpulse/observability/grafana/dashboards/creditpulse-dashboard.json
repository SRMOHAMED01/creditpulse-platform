{
  "title": "CreditPulse - Business & Technical Dashboard",
  "tags": ["creditpulse", "prometheus"],
  "description": "Credit risk scoring platform monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "title": "API Request Rate",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[5m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "API Latency (p95)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "title": "Credit Applications (Score)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(credit_application_score_sum) / count(credit_application_score_count)",
          "legendFormat": "Avg Score"
        }
      ]
    },
    {
      "title": "Credit Applications Accepted",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(credit_application_accepted_total)",
          "legendFormat": "Accepted"
        }
      ]
    }
  ]
}
FROM node:20-alpine

WORKDIR /app

# Base URL de l'API, résolue au build (ex. /api derrière l'Ingress K8s,
# vide pour le comportement docker-compose = http://localhost:8000).
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

# .env.local a la priorité maximale dans Vite : le serveur de dev et le
# bundle client récupèrent la valeur au démarrage du conteneur.
RUN if [ -n "$VITE_API_BASE_URL" ]; then \
      printf 'VITE_API_BASE_URL=%s\n' "$VITE_API_BASE_URL" > .env.local; \
    fi

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
